{
  "name": "jarvis-assistant-stack",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "JARVIS consolidated local kernel with a deployable static preview and authenticated opt-in task frontend.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test test/*.test.js",
    "test:browser": "playwright test",
    "start:kernel": "node kernel/http.js",
    "start:static": "node server.mjs",
    "test:kernel": "node --test test/kernel*.test.js test/router*.test.js test/mcp*.test.js test/upstream*.test.js test/gm-mcp.test.js test/last30days.test.js test/hardening.test.js test/playwright-mcp.test.js",
    "pretest": "npm run build",
    "pretest:kernel": "npm run build",
    "upstream": "node scripts/upstream.mjs",
    "upstream:check": "node scripts/upstream.mjs check",
    "upstream:verify": "node scripts/upstream.mjs verify",
    "mcp:playwright:install": "node scripts/install-playwright-mcp.mjs"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "jsdom": "30.1.2",
    "vite": "8.3.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1"
  }
}
